---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="IITM BS Quiz 1 Practice & Previous Year Questions (PYQs) | BSH"
  description="Practice Quiz 1 with IITM BS Degree previous year question papers (PYQs). Instant solutions, interactive mock tests, and subject-wise quiz practice engines for IIT Madras BS Data Science & Electronic Systems."
  activePage="quiz_practice"
  rootPrefix=""
>
  <Fragment slot="head">
<script type="application/ld+json">
{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "BSH Home",
          "item": "https://bsstudentshelper.vercel.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Quiz Practice Modes",
          "item": "https://bsstudentshelper.vercel.app/quiz_practice.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Quiz 1 Question Papers",
          "item": "https://bsstudentshelper.vercel.app/quiz_1_practice.html"
        }
      ]
    }
</script>
<link rel="stylesheet" href="/assets/css/quiz-portal.css?v=1.0.5">
<style is:inline>
.page-wrap {
            max-width: 1100px;
            margin: 0 auto;
        }

        .mode-banner {
            background: linear-gradient(135deg, #38bdf822, #2563eb22);
            border: 1px solid #2563eb44;
            border-radius: var(--radius-xl);
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .mode-banner-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: linear-gradient(135deg, #38bdf8, #2563eb);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .papers-toolbar {
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 0;
            box-shadow: none;
            margin-bottom: 1rem;
        }

        .papers-title-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .papers-title {
            font-family: var(--font-display);
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            letter-spacing: 0.02em;
        }

        .papers-title span {
            background: none;
            -webkit-background-clip: unset;
            background-clip: unset;
            color: var(--accent-cyan);
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            padding: 0.35rem 0.75rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            transition: all 0.2s;
        }

        .back-link:hover {
            color: var(--accent-purple);
            border-color: var(--accent-purple);
        }

        .filter-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1.25rem;
            margin-bottom: 0.6rem;
            align-items: flex-start;
        }

        .filter-group {
            flex: 0 1 auto;
        }

        .filter-group.course-group {
            width: 240px;
            max-width: 100%;
        }

        .filter-group.year-group {
            width: 130px;
            max-width: 100%;
        }

        .filter-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.3rem;
        }

        .filter-group select {
            width: 100%;
            padding: 0.45rem 0.75rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--bg-surface);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            outline: none;
            appearance: none;
            -webkit-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 0.65rem center;
            background-size: 0.9em;
            padding-right: 2rem;
        }

        .filter-group select:focus {
            border-color: var(--accent-purple);
            box-shadow: none;
        }

        .filter-hint {
            font-size: 0.73rem;
            color: var(--text-muted);
            font-style: italic;
            line-height: 1.4;
            margin: 0;
            padding-top: 0.2rem;
        }

        .filter-hint code {
            background: transparent;
            padding: 0;
            border-radius: 0;
            font-size: inherit;
            border: none;
            font-style: normal;
        }

        .divider-line {
            height: 1px;
            background: var(--border-color);
            opacity: 0.5;
            margin: 1.5rem 0 2.5rem 0;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 1.5rem;
            text-align: center;
            border: none;
            border-radius: 0;
            background: transparent;
        }

        .empty-state img.empty-state-img {
            width: 220px;
            max-width: 85%;
            height: auto;
            margin-bottom: 1.5rem;
            filter: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .empty-state:hover img.empty-state-img {
            transform: translateY(-4px);
            filter: none;
        }

        .empty-state h3 {
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.35rem;
        }

        .empty-state p {
            color: var(--text-muted);
            max-width: 420px;
            font-size: 0.85rem;
            line-height: 1.5;
            margin: 0;
        }

        .papers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 0.85rem;
            display: none;
        }

        .papers-grid.active {
            display: grid;
        }

        .paper-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0.85rem 1rem;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .paper-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent-purple);
            box-shadow: none;
        }

        .paper-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, #38bdf833, #2563eb33);
            color: #2563eb;

            [data-theme="dark"] & {
                color: #60a5fa;
            }

            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }

        .paper-title {
            font-family: var(--font-display);
            font-size: 0.88rem;
            color: var(--text-primary);
            margin: 0;
            line-height: 1.3;
        }

        .paper-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            margin-top: auto;
        }

        .paper-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.18rem 0.45rem;
            border-radius: 999px;
            font-size: 0.68rem;
            font-weight: 600;
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
        }

        .paper-tag.year {
            color: var(--accent-purple);
        }

        .paper-tag.course {
            color: var(--accent-cyan);
        }
</style>
  </Fragment>

  <main>
        <section class="section" style="padding:2rem 0 4rem;">
            <div class="container page-wrap">

                <!-- Toolbar: Title + Filters -->
                <div class="papers-toolbar">
                    <div class="papers-title-row">
                        <h2 class="papers-title">QUIZ 1 - <span>QUESTION PAPERS</span></h2>
                        <a href="quiz_practice.html" class="back-link"><i class="fa-solid fa-arrow-left"></i> All Quiz
                            Modes</a>
                    </div>

                    <div class="filter-row">
                        <div class="filter-group course-group">
                            <label for="courseSelect">Select Course</label>
                            <select id="courseSelect">
                                <option value="">Select course...</option>
                                <option value="maths1">Mathematics for Data Science I</option>
                                <option value="maths2">Mathematics for Data Science II</option>
                                <option value="stats1">Statistics for Data Science I</option>
                                <option value="stats2">Statistics for Data Science II</option>
                                <option value="ct">Computational Thinking</option>
                                <option value="english1">English I</option>
                                <option value="english2">English II</option>
                                <option value="python">Python Programming</option>
                                <option value="java">Programming Concepts Using Java</option>
                                <option value="ba">Business Analytics</option>
                                <option value="mad2">Modern Application Development II</option>
                                <option value="ml">Machine Learning</option>
                                <option value="es-embedded">ES - Embedded Systems</option>
                            </select>
                        </div>
                        <div class="filter-group year-group">
                            <label for="yearSelect">Year</label>
                            <select id="yearSelect">
                                <option value="all">All</option>
                                <option value="2026">2026</option>
                                <option value="2025">2025</option>
                                <option value="2024">2024</option>
                                <option value="2023">2023</option>
                            </select>
                        </div>
                    </div>

                    <p class="filter-hint">
                        There may be some courses in different name. eg: You might see Math 1 and Math1 listed
                        separately. Each
                        one will have different Question Papers
                    </p>
                </div>

                <div class="divider-line"></div>

                <!-- Empty State (shown when no course is selected, by default) -->
                <div class="empty-state" id="emptyState">
                    <img loading="lazy" decoding="async" src="assets/images/empty.webp" width="200" height="200" alt="Choose a Course"
                        class="empty-state-img" />
                    <h3>Please Choose a course</h3>
                    <p>Pick a subject from the dropdown above to view available Quiz 1 question papers. Year filter is
                        optional
                        (defaults to <b>All</b>).</p>
                </div>

                <!-- Papers Grid (populated by JS) -->
                <div class="papers-grid" id="papersGrid"></div>

            </div>
        </section>
    </main>

  <Fragment slot="scripts">
<script is:inline>
const QUIZ1_PAPERS = [
            { id: 305, title: "Quiz 1 - Business Analytics - 16 Jul 2026", course: "ba", courseLabel: "BA", year: "2026", url: "Diploma/BA/quiz1/quiz_1_ba_16jul26.html" },
            { id: 301, title: "Quiz 1 - Business Analytics - 15 Mar 2026", course: "ba", courseLabel: "BA", year: "2026", url: "Diploma/BA/quiz1/quiz_1_ba_15mar26.html" },
            { id: 302, title: "Quiz 1 - Business Analytics - 26 Oct 2025", course: "ba", courseLabel: "BA", year: "2025", url: "Diploma/BA/quiz1/quiz_1_ba_26oct25.html" },
            { id: 303, title: "Quiz 1 - Business Analytics - 13 Jul 2025", course: "ba", courseLabel: "BA", year: "2025", url: "Diploma/BA/quiz1/quiz_1_ba_13jul25.html" },
            { id: 304, title: "Quiz 1 - Business Analytics - 23 Feb 2025", course: "ba", courseLabel: "BA", year: "2025", url: "Diploma/BA/quiz1/quiz_1_ba_23feb25.html" },
            { id: 201, title: "Quiz 1 - Mathematics for Data Science I - 16 Jul 2026", course: "maths1", courseLabel: "Maths 1", year: "2026", url: "Foundation/maths1/quiz1/quiz_1_maths1_16jul26.html" },
            { id: 202, title: "Quiz 1 - Mathematics for Data Science I - 15 Mar 2026", course: "maths1", courseLabel: "Maths 1", year: "2026", url: "Foundation/maths1/quiz1/quiz_1_maths1_15mar26.html" },
            { id: 203, title: "Quiz 1 - Mathematics for Data Science I - 26 Oct 2025", course: "maths1", courseLabel: "Maths 1", year: "2025", url: "Foundation/maths1/quiz1/quiz_1_maths1_26oct25.html" },
            { id: 204, title: "Quiz 1 - Mathematics for Data Science I - 13 Jul 2025", course: "maths1", courseLabel: "Maths 1", year: "2025", url: "Foundation/maths1/quiz1/quiz_1_maths1_13jul25.html" },
            { id: 205, title: "Quiz 1 - Mathematics for Data Science I - 23 Feb 2025", course: "maths1", courseLabel: "Maths 1", year: "2025", url: "Foundation/maths1/quiz1/quiz_1_maths1_23feb25.html" },
            { id: 101, title: "Quiz 1 - Programming in Python - 16 Jul 2026", course: "python", courseLabel: "Python", year: "2026", url: "Foundation/python/quiz1/quiz_1_python_16jul26.html" },
            { id: 102, title: "Quiz 1 - Programming in Python - 15 Mar 2026", course: "python", courseLabel: "Python", year: "2026", url: "Foundation/python/quiz1/quiz_1_python_15mar26.html" },
            { id: 103, title: "Quiz 1 - Programming in Python - 26 Oct 2025", course: "python", courseLabel: "Python", year: "2025", url: "Foundation/python/quiz1/quiz_1_python_26oct25.html" },
            { id: 104, title: "Quiz 1 - Programming in Python - 13 Jul 2025", course: "python", courseLabel: "Python", year: "2025", url: "Foundation/python/quiz1/quiz_1_python_13jul25.html" },
            { id: 105, title: "Quiz 1 - Programming in Python - 23 Feb 2025", course: "python", courseLabel: "Python", year: "2025", url: "Foundation/python/quiz1/quiz_1_python_23feb25.html" },
        ];

        const courseSelect = document.getElementById('courseSelect');
        const yearSelect = document.getElementById('yearSelect');
        const emptyState = document.getElementById('emptyState');
        const papersGrid = document.getElementById('papersGrid');

        function renderPapers() {
            const courseVal = courseSelect.value;
            const yearVal = yearSelect.value;

            // If no course selected → empty state (matches your screenshot: "Please Choose a course")
            if (!courseVal) {
                emptyState.style.display = 'flex';
                papersGrid.classList.remove('active');
                papersGrid.innerHTML = '';
                return;
            }

            // Filter: by course (required) AND year (optional; "all" = show all years)
            let filtered = QUIZ1_PAPERS.filter(p => p.course === courseVal);
            if (yearVal !== 'all') {
                filtered = filtered.filter(p => p.year === yearVal);
            }

            if (filtered.length === 0) {
                // Empty state variant for "no results"
                emptyState.style.display = 'flex';
                emptyState.querySelector('h3').textContent = 'No papers found';
                emptyState.querySelector('p').innerHTML = `Try changing the <b>Year</b> filter or pick another course.`;
                papersGrid.classList.remove('active');
                papersGrid.innerHTML = '';
                return;
            }

            // Reset empty state heading back to default in case it changed
            emptyState.style.display = 'none';
            emptyState.querySelector('h3').textContent = 'Please Choose a course';
            emptyState.querySelector('p').innerHTML = `Pick a subject from the dropdown above to view available Quiz 1 question papers. Year filter is optional (defaults to <b>All</b>).`;

            // Render papers
            papersGrid.innerHTML = filtered.map(p => {
                const comingSoonAttr = (!p.url || p.url === '#') ? ' data-coming-soon="Paper viewer launching soon"' : '';
                return `
                <a href="${p.url}" class="paper-card"${comingSoonAttr}>
                    <div class="paper-icon"><i class="fa-regular fa-file-lines"></i></div>
                    <h4 class="paper-title">${p.title}</h4>
                    <div class="paper-meta">
                        <span class="paper-tag course"><i class="fa-solid fa-book"></i> ${p.courseLabel}</span>
                        <span class="paper-tag year"><i class="fa-solid fa-calendar"></i> ${p.year}</span>
                        <span class="paper-tag"><i class="fa-solid fa-pen"></i> Quiz 1</span>
                    </div>
                </a>
            `;
            }).join('');
            papersGrid.classList.add('active');
        }

        

        // Initial render: no course selected → empty state (per your "by default show all years but user should pick a course" logic)
        

        
        

        function initPage() {
            if (typeof setupSearchableCourseSelect === 'function') {
                setupSearchableCourseSelect('courseSelect', renderPapers);
            }
            renderPapers();
            if (courseSelect) courseSelect.addEventListener('change', renderPapers);
            if (yearSelect) yearSelect.addEventListener('change', renderPapers);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPage);
        } else {
            initPage();
        }
</script>
  </Fragment>
</Layout>
