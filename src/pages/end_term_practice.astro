---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="IITM BS End Term Practice & Previous Year Papers (PYQs) | BSH"
  description="Practice End Term exams with IITM BS Degree previous year question papers. Comprehensive mock tests, answer keys, and exam practice engines for IIT Madras BS courses."
  activePage="quiz_practice"
  rootPrefix=""
>
  <Fragment slot="head">
<script type="application/ld+json">
{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "BSH Home",
          "item": "https://bsstudentshelper.vercel.app/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Quiz Practice Modes",
          "item": "https://bsstudentshelper.vercel.app/quiz_practice.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "End Term Question Papers",
          "item": "https://bsstudentshelper.vercel.app/end_term_practice.html"
        }
      ]
    }
</script>
<link rel="stylesheet" href="/assets/css/quiz-portal.css">
<style is:inline>
.page-wrap {
            max-width: 1100px;
            margin: 0 auto;
        }

        .mode-banner {
            background: linear-gradient(135deg, #34d39922, #05966922);
            border: 1px solid #05966944;
            border-radius: var(--radius-xl);
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .mode-banner-icon {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: linear-gradient(135deg, #34d399, #059669);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .papers-toolbar {
            background: transparent;
            border: none;
            border-radius: 0;
            padding: 0;
            box-shadow: none;
            margin-bottom: 1rem;
        }

        .papers-title-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.25rem;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .papers-title {
            font-family: var(--font-display);
            font-size: 1.35rem;
            font-weight: 600;
            color: var(--text-primary);
            margin: 0;
            letter-spacing: 0.02em;
        }

        .papers-title span {
            background: none;
            -webkit-background-clip: unset;
            background-clip: unset;
            color: var(--accent-green);
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 500;
            padding: 0.35rem 0.75rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            transition: all 0.2s;
        }

        .back-link:hover {
            color: var(--accent-purple);
            border-color: var(--accent-purple);
        }

        .filter-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1.25rem;
            margin-bottom: 0.6rem;
            align-items: flex-start;
        }

        .filter-group {
            flex: 0 1 auto;
        }

        .filter-group.course-group {
            width: 240px;
            max-width: 100%;
        }

        .filter-group.year-group {
            width: 130px;
            max-width: 100%;
        }

        .filter-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.3rem;
        }

        .filter-group select {
            width: 100%;
            padding: 0.45rem 0.75rem;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--bg-surface);
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.15s ease;
            outline: none;
            appearance: none;
            -webkit-appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b7280' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 0.65rem center;
            background-size: 0.9em;
            padding-right: 2rem;
        }

        .filter-group select:focus {
            border-color: var(--accent-purple);
            box-shadow: none;
        }

        .filter-hint {
            font-size: 0.73rem;
            color: var(--text-muted);
            font-style: italic;
            line-height: 1.4;
            margin: 0;
            padding-top: 0.2rem;
        }

        .filter-hint code {
            background: transparent;
            padding: 0;
            border-radius: 0;
            font-size: inherit;
            border: none;
            font-style: normal;
        }

        .divider-line {
            height: 1px;
            background: var(--border-color);
            opacity: 0.5;
            margin: 1.5rem 0 2.5rem 0;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 3rem 1.5rem;
            text-align: center;
            border: none;
            border-radius: 0;
            background: transparent;
        }

        .empty-state img.empty-state-img {
            width: 220px;
            max-width: 85%;
            height: auto;
            margin-bottom: 1.5rem;
            filter: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .empty-state:hover img.empty-state-img {
            transform: translateY(-4px);
            filter: none;
        }

        .empty-state h3 {
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.35rem;
        }

        .empty-state p {
            color: var(--text-muted);
            max-width: 420px;
            font-size: 0.85rem;
            line-height: 1.5;
            margin: 0;
        }

        .papers-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 0.85rem;
            display: none;
        }

        .papers-grid.active {
            display: grid;
        }

        .paper-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 0.85rem 1rem;
            text-decoration: none;
            color: inherit;
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .paper-card:hover {
            transform: translateY(-2px);
            border-color: var(--accent-purple);
            box-shadow: none;
        }

        .paper-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: linear-gradient(135deg, #34d39933, #05966933);
            color: #059669;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.95rem;
        }

        [data-theme="dark"] .paper-icon {
            color: #6ee7b7;
        }

        .paper-title {
            font-family: var(--font-display);
            font-size: 0.88rem;
            color: var(--text-primary);
            margin: 0;
            line-height: 1.3;
        }

        .paper-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            margin-top: auto;
        }

        .paper-tag {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            padding: 0.18rem 0.45rem;
            border-radius: 999px;
            font-size: 0.68rem;
            font-weight: 600;
            background: var(--bg-surface);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
        }

        .paper-tag.year {
            color: var(--accent-purple);
        }

        .paper-tag.course {
            color: var(--accent-cyan);
        }
</style>
  </Fragment>

  <main>
        <section class="section" style="padding:2rem 0 4rem;">
            <div class="container page-wrap">
                <div class="papers-toolbar">
                    <div class="papers-title-row">
                        <h2 class="papers-title">END TERM - <span>QUESTION PAPERS</span></h2>
                        <a href="quiz_practice.html" class="back-link"><i class="fa-solid fa-arrow-left"></i> All Quiz
                            Modes</a>
                    </div>
                    <div class="filter-row">
                        <div class="filter-group course-group">
                            <label for="courseSelect">Select Course</label>
                            <select id="courseSelect">
                                <option value="">Select course...</option>
                                <option value="maths1">Mathematics for Data Science I</option>
                                <option value="maths2">Mathematics for Data Science II</option>
                                <option value="stats1">Statistics for Data Science I</option>
                                <option value="stats2">Statistics for Data Science II</option>
                                <option value="ct">Computational Thinking</option>
                                <option value="english1">English I</option>
                                <option value="english2">English II</option>
                                <option value="python">Python Programming</option>
                                <option value="java">Programming Concepts Using Java</option>
                                <option value="mad2">Modern Application Development II</option>
                                <option value="mlp">Machine Learning Practice</option>
                                <option value="ml">Machine Learning</option>
                                <option value="mlf">Machine Learning Foundations</option>
                                <option value="mlt">Machine Learning Techniques</option>
                                <option value="es-embedded">ES - Embedded Systems</option>
                            </select>
                        </div>
                        <div class="filter-group year-group">
                            <label for="yearSelect">Year</label>
                            <select id="yearSelect">
                                <option value="all">All</option>
                                <option value="2026">2026</option>
                                <option value="2025">2025</option>
                                <option value="2024">2024</option>
                                <option value="2023">2023</option>
                            </select>
                        </div>
                    </div>

                    <p class="filter-hint">
                        There may be some courses in different name. eg: You might see Math 1 and Math1 listed
                        separately. Each one will have different Question Papers
                    </p>
                </div>

                <div class="divider-line"></div>

                <div class="empty-state" id="emptyState">
                    <img loading="lazy" decoding="async" src="assets/images/empty.webp" width="200" height="200" alt="Choose a Course" class="empty-state-img" />
                    <h3>Please Choose a course</h3>
                    <p>Pick a subject from the dropdown above to view available End Term question papers. Year filter is
                        optional (defaults to <b>All</b>).</p>
                </div>

                <div class="papers-grid" id="papersGrid"></div>
            </div>
        </section>
    </main>

  <Fragment slot="scripts">
<script is:inline>
const ENDTERM_PAPERS = [
            { id: 401, title: "End Term - Machine Learning Practice - 06 May 2026", course: "mlp", courseLabel: "MLP", year: "2026", url: "Diploma/mlp/endterm/end_term_mlp_06may26.html" },
            { id: 402, title: "End Term - Machine Learning Practice - 13 Sep 2026 (Session 2)", course: "mlp", courseLabel: "MLP", year: "2026", url: "Diploma/mlp/endterm/end_term_mlp_13sep26_s2.html" },
            { id: 403, title: "End Term - Machine Learning Practice - 31 Aug 2025", course: "mlp", courseLabel: "MLP", year: "2025", url: "Diploma/mlp/endterm/end_term_mlp_31aug25.html" },
            { id: 404, title: "End Term - Machine Learning Practice - 13 Apr 2025 (FN)", course: "mlp", courseLabel: "MLP", year: "2025", url: "Diploma/mlp/endterm/end_term_mlp_13apr25_fn.html" },
            { id: 405, title: "End Term - Machine Learning Practice - 13 Apr 2025 (AN)", course: "mlp", courseLabel: "MLP", year: "2025", url: "Diploma/mlp/endterm/end_term_mlp_13apr25_an.html" },
            { id: 306, title: "End Term - Machine Learning Techniques - 06 May 2026 (FN)", course: "mlt", courseLabel: "MLT", year: "2026", url: "Diploma/mlt/endterm/end_term_mlt_06may26_fn.html" },
            { id: 302, title: "End Term - Machine Learning Techniques - 06 May 2026 (AN)", course: "mlt", courseLabel: "MLT", year: "2026", url: "Diploma/mlt/endterm/end_term_mlt_06may26_an.html" },
            { id: 301, title: "End Term - Machine Learning Techniques - 18 Dec 2025", course: "mlt", courseLabel: "MLT", year: "2025", url: "Diploma/mlt/endterm/end_term_mlt_18dec25.html" },
            { id: 303, title: "End Term - Machine Learning Techniques - 31 Aug 2025", course: "mlt", courseLabel: "MLT", year: "2025", url: "Diploma/mlt/endterm/end_term_mlt_31aug25.html" },
            { id: 304, title: "End Term - Machine Learning Techniques - 13 Apr 2025 (FN)", course: "mlt", courseLabel: "MLT", year: "2025", url: "Diploma/mlt/endterm/end_term_mlt_13apr25_fn.html" },
            { id: 305, title: "End Term - Machine Learning Techniques - 13 Apr 2025 (AN)", course: "mlt", courseLabel: "MLT", year: "2025", url: "Diploma/mlt/endterm/end_term_mlt_13apr25_an.html" },
            { id: 201, title: "End Term - Modern Application Development II - 06 May 2026", course: "mad2", courseLabel: "AppDev2", year: "2026", url: "Diploma/mad2/endterm/end_term_mad2_06may26.html" },
            { id: 202, title: "End Term - Modern Application Development II - 18 Dec 2025", course: "mad2", courseLabel: "AppDev2", year: "2025", url: "Diploma/mad2/endterm/end_term_mad2_18dec25.html" },
            { id: 203, title: "End Term - Modern Application Development II - 31 Aug 2025", course: "mad2", courseLabel: "AppDev2", year: "2025", url: "Diploma/mad2/endterm/end_term_mad2_31aug25.html" },
            { id: 204, title: "End Term - Modern Application Development II - 13 Apr 2025 (FN)", course: "mad2", courseLabel: "AppDev2", year: "2025", url: "Diploma/mad2/endterm/end_term_mad2_13apr25_fn.html" },
            { id: 205, title: "End Term - Modern Application Development II - 13 Apr 2025 (AN)", course: "mad2", courseLabel: "AppDev2", year: "2025", url: "Diploma/mad2/endterm/end_term_mad2_13apr25_an.html" },
            { id: 206, title: "End Term - Modern Application Development II - 28 Apr 2024 (AN)", course: "mad2", courseLabel: "AppDev2", year: "2024", url: "Diploma/mad2/endterm/end_term_mad2_28apr24_an.html" },
            { id: 101, title: "End Term - Programming Concepts Using Java - 06 May 2026", course: "java", courseLabel: "Java", year: "2026", url: "Diploma/java/endterm/end_term_java_06may26.html" },
            { id: 102, title: "End Term - Programming Concepts Using Java - 18 Dec 2025", course: "java", courseLabel: "Java", year: "2025", url: "Diploma/java/endterm/end_term_java_18dec25.html" },
            { id: 103, title: "End Term - Programming Concepts Using Java - 31 Aug 2025", course: "java", courseLabel: "Java", year: "2025", url: "Diploma/java/endterm/end_term_java_31aug25.html" },
            { id: 104, title: "End Term - Programming Concepts Using Java - 13 Apr 2025", course: "java", courseLabel: "Java", year: "2025", url: "Diploma/java/endterm/end_term_java_13apr25.html" },
            { id: 105, title: "End Term - Programming Concepts Using Java - 22 Dec 2024 (FN)", course: "java", courseLabel: "Java", year: "2024", url: "Diploma/java/endterm/end_term_java_22dec24_fn.html" },
            { id: 106, title: "End Term - Programming Concepts Using Java - 22 Dec 2024 (AN)", course: "java", courseLabel: "Java", year: "2024", url: "Diploma/java/endterm/end_term_java_22dec24_an.html" },
            { id: 1, title: "End Term - Mathematics for Data Science I - Nov 2025", course: "maths1", courseLabel: "Maths 1", year: "2025", url: "#" },
            { id: 2, title: "End Term - Statistics for Data Science I - Nov 2025", course: "stats1", courseLabel: "Stats 1", year: "2025", url: "#" },
            { id: 3, title: "End Term - Statistics for Data Science I - Nov 2024", course: "stats1", courseLabel: "Stats 1", year: "2024", url: "#" },
            { id: 4, title: "End Term - Computational Thinking - Nov 2024", course: "ct", courseLabel: "CT", year: "2024", url: "#" },
            { id: 5, title: "End Term - Python Programming - Nov 2024", course: "python", courseLabel: "Python", year: "2024", url: "#" },
            { id: 6, title: "End Term - Mathematics for Data Science II - Nov 2025", course: "maths2", courseLabel: "Maths 2", year: "2025", url: "#" },
            { id: 7, title: "End Term - Machine Learning - Nov 2023", course: "ml", courseLabel: "ML", year: "2023", url: "#" },
            { id: 8, title: "End Term - Statistics for Data Science II - Nov 2025", course: "stats2", courseLabel: "Stats 2", year: "2025", url: "#" },
        ];

        const courseSelect = document.getElementById('courseSelect');
        const yearSelect = document.getElementById('yearSelect');
        const emptyState = document.getElementById('emptyState');
        const papersGrid = document.getElementById('papersGrid');
        const DEFAULT_EMPTY_HEADING = 'Please Choose a course';
        const DEFAULT_EMPTY_DESC = `Pick a subject from the dropdown above to view available End Term question papers. Year filter is optional (defaults to <b>All</b>).`;

        function renderPapers() {
            const courseVal = courseSelect.value;
            const yearVal = yearSelect.value;
            if (!courseVal) {
                emptyState.style.display = 'flex';
                emptyState.querySelector('h3').textContent = DEFAULT_EMPTY_HEADING;
                emptyState.querySelector('p').innerHTML = DEFAULT_EMPTY_DESC;
                papersGrid.classList.remove('active');
                papersGrid.innerHTML = '';
                return;
            }
            let filtered = ENDTERM_PAPERS.filter(p => p.course === courseVal);
            if (yearVal !== 'all') filtered = filtered.filter(p => p.year === yearVal);

            if (filtered.length === 0) {
                emptyState.style.display = 'flex';
                emptyState.querySelector('h3').textContent = 'No papers found';
                emptyState.querySelector('p').innerHTML = `Try changing the <b>Year</b> filter or pick another course.`;
                papersGrid.classList.remove('active');
                papersGrid.innerHTML = '';
                return;
            }
            emptyState.style.display = 'none';
            papersGrid.innerHTML = filtered.map(p => {
                const comingSoonAttr = (!p.url || p.url === '#') ? ' data-coming-soon="Paper viewer launching soon"' : '';
                return `
                <a href="${p.url}" class="paper-card"${comingSoonAttr}>
                    <div class="paper-icon"><i class="fa-regular fa-file-lines"></i></div>
                    <h4 class="paper-title">${p.title}</h4>
                    <div class="paper-meta">
                        <span class="paper-tag course"><i class="fa-solid fa-book"></i> ${p.courseLabel}</span>
                        <span class="paper-tag year"><i class="fa-solid fa-calendar"></i> ${p.year}</span>
                        <span class="paper-tag"><i class="fa-solid fa-graduation-cap"></i> End Term</span>
                    </div>
                </a>
            `;
            }).join('');
            papersGrid.classList.add('active');
        }

        

        
        
        

        function initPage() {
            if (typeof setupSearchableCourseSelect === 'function') {
                setupSearchableCourseSelect('courseSelect', renderPapers);
            }
            renderPapers();
            if (courseSelect) courseSelect.addEventListener('change', renderPapers);
            if (yearSelect) yearSelect.addEventListener('change', renderPapers);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPage);
        } else {
            initPage();
        }
</script>
  </Fragment>
</Layout>
