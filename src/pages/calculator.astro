---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="CGPA Calculator | IIT Madras BS Degree"
  description="Calculate your exact course score (T), letter grade (S, A, B, C, D, E), and CGPA for all IIT Madras BS Foundational, Diploma, and Degree courses using official May 2026 term formulas."
  activePage="calculator"
  rootPrefix=""
>
  <Fragment slot="head">
<script type="application/ld+json">
{
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebApplication",
          "@id": "https://bsstudentshelper.vercel.app/calculator#webapp",
          "url": "https://bsstudentshelper.vercel.app/calculator",
          "name": "IIT Madras BS SEC Grade Calculator",
          "applicationCategory": "EducationalApplication",
          "operatingSystem": "All",
          "description": "Calculate exact course total scores (T), letter grades, and target Quiz 2 / End-Term scores for IIT Madras BS in Data Science & Electronic Systems.",
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.9",
            "ratingCount": "128",
            "reviewCount": "128",
            "bestRating": "5",
            "worstRating": "1"
          },
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "INR"
          }
        },
        {
          "@type": "BreadcrumbList",
          "@id": "https://bsstudentshelper.vercel.app/calculator#breadcrumb",
          "itemListElement": [
            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "https://bsstudentshelper.vercel.app/"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "SEC Grade Calculator",
              "item": "https://bsstudentshelper.vercel.app/calculator"
            }
          ]
        }
      ]
    }
</script>
<link rel="stylesheet" href="/assets/css/calculator.css?v=1.0.5">

  </Fragment>

  <main>
        <!-- Hero Banner -->
        <section class="calc-hero">
            <div class="container hero-header">
                <div class="pill-badge mb-2">
                    <span class="badge-dot"></span>
                    <span>Updated May 2026 Term Official Rules</span>
                </div>
                <h1 class="calc-hero-title">IITM BS Course Grade & SEC Calculator</h1>
                <p class="calc-hero-sub">
                    Select any course across Foundational, Diploma, or Degree levels to view its official grading
                    formula
                    and calculate your exact course score ($T$), letter grade ($S, A, B, C, D, E$), and target End-Term
                    preparation requirements.
                </p>

                <!-- Switcher Tabs: Course Calculator vs CGPA Predictor -->
                <div class="mode-tabs-wrapper">
                    <div class="mode-tabs">
                        <button class="tab-btn active" id="tabCourseCalc">
                            <i class="fa-solid fa-calculator"></i>
                            <span>Course Grade Calculator</span>
                        </button>
                        <button class="tab-btn" id="tabCgpaCalc">
                            <i class="fa-solid fa-chart-pie"></i>
                            <span>CGPA & Term GPA Predictor</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Calculator Section -->
        <section class="calc-section">
            <div class="container">

                <!-- 1. COURSE GRADE CALCULATOR TAB -->
                <div id="courseCalcSection">
                    <!-- Level Filter Chips -->
                    <div class="level-filters">
                        <button class="filter-chip active" data-level="all">All Courses (35+)</button>
                        <button class="filter-chip" data-level="foundational">Foundational Level</button>
                        <button class="filter-chip" data-level="diploma">Diploma Level</button>
                        <button class="filter-chip" data-level="degree">Degree Level</button>
                    </div>

                    <!-- Subject Picker Card -->
                    <div class="subject-picker-card">
                        <div class="picker-header">
                            <label class="picker-label" for="subjectSelect">
                                <i class="fa-solid fa-book"></i> Select Course / Subject
                            </label>
                            <div class="search-box-wrap">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="text" id="subjectSearch"
                                    placeholder="Search subject (e.g. Stats, Python, MLP...)" class="search-input" />
                            </div>
                        </div>

                        <div class="select-wrapper">
                            <select id="subjectSelect" class="subject-select">
                                <!-- Populated dynamically by JavaScript -->
                            </select>
                            <i class="fa-solid fa-chevron-down select-arrow"></i>
                        </div>
                    </div>

                    <!-- Dynamic Formula Banner -->
                    <div class="formula-info-box" id="formulaInfoBox">
                        <div class="formula-header">
                            <div class="formula-title">
                                <i class="fa-solid fa-square-root-variable" style="color: var(--accent-gold);"></i>
                                <span id="displaySubjectName">Mathematics for Data Science 1</span>
                            </div>
                            <span class="level-tag" id="displayLevelTag">FOUNDATIONAL LEVEL • 4 CREDITS</span>
                        </div>
                        <div class="formula-body">
                            <div class="formula-equation-box" id="displayFormulaEquation">
                                T = max(0.6*F + 0.3*max(Qz1, Qz2), 0.45*F + 0.25*Qz1 + 0.3*Qz2)
                            </div>
                            <div class="formula-notes" id="displayFormulaNotes">
                                <!-- Notes populated via JS -->
                            </div>
                        </div>
                    </div>

                    <!-- Calculator Interactive Form & Output Grid -->
                    <div class="calc-grid">
                        <!-- Input Controls Card -->
                        <div class="calc-card">
                            <div class="card-title-bar">
                                <h3><i class="fa-solid fa-sliders"></i> Enter Your Component Scores</h3>
                                <span class="pill-badge" style="font-size: 0.75rem;">Scale: 0 - 100</span>
                            </div>

                            <div class="form-inputs-wrap" id="dynamicInputsWrap">
                                <!-- Inputs populated dynamically by JavaScript -->
                            </div>
                        </div>

                        <!-- Result Output Analytics Card -->
                        <div class="calc-card">
                            <div class="card-title-bar">
                                <h3><i class="fa-solid fa-chart-line"></i> Grade Analytics & Results</h3>
                                <div id="resultStatusBadge" class="pill-badge text-success">
                                    <i class="fa-solid fa-circle-check"></i> Eligible
                                </div>
                            </div>

                            <div class="result-card-inner">
                                <div class="grade-display-circle">
                                    <svg viewBox="0 0 100 100" class="grade-ring-svg">
                                        <circle class="ring-bg" cx="50" cy="50" r="42"></circle>
                                        <circle class="ring-fill" id="resultGradeRing" cx="50" cy="50" r="42"
                                            stroke-dasharray="264" stroke-dashoffset="30"></circle>
                                    </svg>
                                    <div class="grade-center-text">
                                        <span class="predicted-grade" id="resultGradeLetter">S</span>
                                        <span class="grade-subtext">Letter Grade</span>
                                    </div>
                                </div>

                                <div class="summary-box">
                                    <div class="summary-row">
                                        <span>Total Weighted Score (T):</span>
                                        <strong id="resultTotalScore">85.4 / 100</strong>
                                    </div>
                                    <div class="summary-row">
                                        <span>Grade Points (10 Scale):</span>
                                        <strong id="resultGradePoints">10 Points</strong>
                                    </div>
                                    <div class="summary-row">
                                        <span>Course Status:</span>
                                        <strong class="text-success"><i class="fa-solid fa-check"></i> PASS
                                            GRADE</strong>
                                    </div>
                                </div>

                                <div class="breakdown-box">
                                    <div class="breakdown-title">
                                        <i class="fa-solid fa-calculator"></i> Step-by-Step Formula Evaluation
                                    </div>
                                    <div class="breakdown-list" id="resultStepList">
                                        <!-- Steps populated dynamically -->
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Target End-Term Score Predictor Card -->
                    <div class="target-predictor-card">
                        <div class="card-title-bar">
                            <h3><i class="fa-solid fa-bullseye"></i> Target End-Term Score Predictor</h3>
                            <span class="pill-badge"><i class="fa-solid fa-lightbulb"></i> Minimum End Term Exam Marks
                                Needed</span>
                        </div>
                        <p class="calc-hero-sub" style="font-size: 0.95rem; text-align: left; margin-bottom: 0;">
                            Based on your currently entered Quiz and Assignment scores, here are the exact minimum
                            End-Term exam marks you need to secure target letter grades:
                        </p>
                        <div class="target-grid" id="targetGrid">
                            <!-- Populated dynamically -->
                        </div>
                    </div>
                </div>

                <!-- 2. CGPA & TERM GPA PREDICTOR TAB -->
                <div id="cgpaCalcSection" class="hidden">
                    <div class="cgpa-container">
                        <div class="card-title-bar mb-3">
                            <h3><i class="fa-solid fa-graduation-cap"></i> IITM BS Cumulative CGPA & SGPA Estimator</h3>
                            <div id="cgpaStatusBadge" class="pill-badge text-success">
                                <i class="fa-solid fa-star"></i> High Distinction Target
                            </div>
                        </div>

                        <!-- Prior Academic Record Inputs (Current CGPA, Credits Earned, Subjects Completed) -->
                        <div class="prior-record-grid mb-4">
                            <div class="prior-record-box">
                                <label for="priorCgpaInput" class="prior-label">Current CGPA</label>
                                <input type="number" id="priorCgpaInput" class="prior-input" step="0.01" min="0"
                                    max="10" placeholder="0.00" />
                            </div>
                            <div class="prior-record-box">
                                <label for="priorCreditsInput" class="prior-label">Credits Earned</label>
                                <input type="number" id="priorCreditsInput" class="prior-input" min="0" max="300"
                                    placeholder="0" />
                            </div>
                            <div class="prior-record-box">
                                <label for="priorSubjectsInput" class="prior-label">Subjects Completed</label>
                                <input type="number" id="priorSubjectsInput" class="prior-input" min="0" max="100"
                                    placeholder="0" />
                            </div>
                        </div>
                        <br>

                        <!-- Semester Subjects Section Card Container -->
                        <div class="semester-section-header">
                            <h4 class="semester-title"><i class="fa-solid fa-book-bookmark"></i> Semester Subjects</h4>
                        </div>

                        <div class="semester-card-wrapper mb-4">
                            <div id="semesterSubjectsList" class="semester-subjects-list">
                                <!-- Dynamic Subject Rows populated via JS -->
                            </div>
                                <br>
                            <div class="semester-actions mt-3">
                                <button class="btn btn-secondary btn-add-subj" id="addSemesterSubjectBtn">
                                    <i class="fa-solid fa-plus"></i> Add Subject
                                </button>
                            </div>
                        </div>
                        <br>
                        <!-- Real-Time CGPA & SGPA Analytics Summary -->
                        <div class="cgpa-analytics-banner mt-4">
                            <div class="cgpa-stat-box">
                                <div class="cgpa-stat-val" id="newCgpaVal">0.00</div>
                                <div class="cgpa-stat-lbl">New Cumulative CGPA</div>
                            </div>
                            <div class="cgpa-stat-divider"></div>
                            <div class="cgpa-stat-box">
                                <div class="cgpa-stat-val text-accent" id="termSgpaVal">0.00</div>
                                <div class="cgpa-stat-lbl">Semester GPA (SGPA)</div>
                            </div>
                            <div class="cgpa-stat-divider"></div>
                            <div class="cgpa-stat-box">
                                <div class="cgpa-stat-val" id="newTotalCreditsVal">0 Credits</div>
                                <div class="cgpa-stat-lbl">Total Credits Earned</div>
                            </div>
                            <div class="cgpa-stat-divider"></div>
                            <div class="cgpa-stat-box">
                                <div class="cgpa-stat-val" id="newTotalSubjectsVal">0</div>
                                <div class="cgpa-stat-lbl">Total Subjects</div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <!-- Footer -->

  <Fragment slot="scripts">
<script is:inline src="/assets/js/calculator.js"></script>
  </Fragment>
</Layout>
