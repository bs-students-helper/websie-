# External Code Execution API Configuration
# Option 1: Piston API (Default public zero-key instance: https://emkc.org/api/v2/piston)
VITE_CODE_EXECUTION_API_URL=https://emkc.org/api/v2/piston

# Option 2: Custom Judge0 / Piston self-hosted proxy URL
# VITE_CODE_EXECUTION_API_URL=https://your-custom-judge0-instance.com/submissions

# IMPORTANT SECURITY NOTE:
# Do NOT put secret private API keys in VITE_* environment variables!
# Any credentials exposed in VITE_* will be visible in public frontend browser bundles.
# If using a paid execution service requiring private keys, deploy a serverless proxy function.
